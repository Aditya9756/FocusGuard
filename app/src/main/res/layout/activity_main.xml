<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="#121212"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="FitGuard Protection"
        android:textColor="#00E676"
        android:textSize="24sp"
        android:textStyle="bold"
        android:layout_marginTop="20dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:layout_marginTop="20dp"
        android:background="#1E1E1E"
        android:padding="16dp"/>

    <Button
        android:id="@+id/btnAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Enable Anti-Uninstall Admin"
        android:layout_marginTop="20dp"
        android:backgroundTint="#2979FF"/>

    <Button
        android:id="@+id/btnAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Enable Accessibility Blocker"
        android:layout_marginTop="10dp"
        android:backgroundTint="#651FFF"/>

    <Button
        android:id="@+id/btnOverlay"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Allow Overlay Permission"
        android:layout_marginTop="10dp"
        android:backgroundTint="#FF9100"/>

    <Button
        android:id="@+id/btnTestLock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Test Exercise Lock Screen"
        android:layout_marginTop="30dp"
        android:backgroundTint="#D50000"/>
</LinearLayout>
